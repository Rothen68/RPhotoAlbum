# Copier en .env et renseigner les valeurs réelles (jamais commité, voir .gitignore).

# pCloud OAuth 2.0 — https://docs.pcloud.com/methods/oauth_2.0/authorize.html
PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=
PCLOUD_REDIRECT_URI=http://localhost/api/auth/pcloud/callback

# Application
APP_BASE_URL=http://localhost
APP_AUTH_SECRET=
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD_HASH=

# Indexation périodique des dossiers source (minutes)
INDEXING_INTERVAL_MINUTES=15

LOG_LEVEL=Information

# Adresse IP (ou nom d'hôte) LAN utilisée pour accéder au serveur — incluse dans le certificat
# HTTPS auto-signé généré automatiquement par reverse-proxy/generate-cert.sh au déploiement
# (requis pour la consultation hors-ligne, issue #29 : l'API Cache Storage du navigateur
# n'existe que dans un contexte sécurisé, HTTPS ou http://localhost). À mettre à jour puis
# relancer deploy.sh si l'IP du serveur change (bail DHCP non réservé) — supprimer
# reverse-proxy/certs/ au préalable pour forcer la régénération, et ré-approuver le nouveau
# certificat sur chaque appareil.
TLS_SAN_IP=192.168.1.100
# Port hôte pour l'accès HTTPS (443 du conteneur reverse-proxy) — 3140 reste le port HTTP
# existant, inchangé, toujours disponible en parallèle.
HTTPS_PORT=3143
