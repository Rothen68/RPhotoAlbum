# Copy to .env and fill in the real values (never committed, see .gitignore).

# pCloud OAuth 2.0 — https://docs.pcloud.com/methods/oauth_2.0/authorize.html
PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=
PCLOUD_REDIRECT_URI=http://localhost/api/auth/pcloud/callback

# Application
APP_BASE_URL=http://localhost
APP_AUTH_SECRET=
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD_HASH=

# Periodic indexing of source folders (minutes)
INDEXING_INTERVAL_MINUTES=15

LOG_LEVEL=Information

# LAN IP address (or hostname) used to access the server — included in the self-signed HTTPS
# certificate automatically generated by reverse-proxy/generate-cert.sh at deploy time (required
# for offline viewing, issue #29: the browser's Cache Storage API only exists in a secure
# context, HTTPS or http://localhost). Update this and re-run deploy.sh if the server's IP
# changes (unreserved DHCP lease) — delete reverse-proxy/certs/ first to force regeneration,
# and re-approve the new certificate on each device.
TLS_SAN_IP=192.168.1.100
# Host port for HTTPS access (container port 443 on reverse-proxy) — 3140 remains the existing
# HTTP port, unchanged, still available in parallel.
HTTPS_PORT=3143
