# Copier en .env et renseigner les valeurs réelles (jamais commité, voir .gitignore).

# pCloud OAuth 2.0 — https://docs.pcloud.com/methods/oauth_2.0/authorize.html
PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=
PCLOUD_REDIRECT_URI=http://localhost/api/auth/pcloud/callback

# Application
APP_BASE_URL=http://localhost
APP_AUTH_SECRET=
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD_HASH=

# Indexation périodique des dossiers source (minutes)
INDEXING_INTERVAL_MINUTES=15

LOG_LEVEL=Information
